# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=5002

# Database Configuration (SQLite)
DB_PATH=./studybuddy.db

# Model Configuration
# Set to 'true' to use local fine-tuned models, 'false' to use HuggingFace models only
USE_LOCAL_MODELS=true

# Set to 'true' to automatically fallback to HuggingFace models if local models fail
FALLBACK_TO_HUGGINGFACE=true

# Local Model Paths (Relative to backend folder)
# These paths will be used if USE_LOCAL_MODELS=true
SUMMARY_MODEL_PATH=./Models/summary_train_model_1
QUESTION_GENERATION_MODEL_PATH=./Models/question_generation_model
QUIZ_MODEL_PATH=./Models/Quiz_Model_Recommended

# HuggingFace Fallback Models (used if local models fail or USE_LOCAL_MODELS=false)
# Options: t5-small, t5-base, google/flan-t5-base, google/flan-t5-small
# Note: flan-t5 models provide better quality but are larger and slower
HUGGINGFACE_SUMMARY_MODEL=t5-small
HUGGINGFACE_QUESTION_MODEL=t5-small
HUGGINGFACE_QUIZ_MODEL=t5-small

# Model Loading Configuration
MODEL_LOAD_DEVICE=cpu
TORCH_DTYPE=float32

# Upload Folders (Relative to backend folder)
UPLOAD_FOLDER=uploads
STUDY_MATERIALS_FOLDER=study_materials
